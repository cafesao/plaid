{
    "name": "plaid",
    "productName": "Plaid",
    "version": "1.0.1",
    "author": {
        "name": "Piotr Marczyński",
        "email": "piotmski@gmail.com"
    },
    "description": "Personal Jira worklog editor",
    "keywords": [
        "jira",
        "worklog",
        "planner",
        "calendar"
    ],
    "license": "MIT",
    "homepage": "https://github.com/piotrmski/plaid",
    "main": "main.js",
    "build": {
        "appId": "com.github.piotrmski.plaid",
        "files": [
            "main.js",
            "bootstrap.js",
            "preload.js",
            "window-state.js",
            "build"
        ],
        "win": {
            "icon": "build/assets/appicon/icon.ico",
            "extraFiles": [
                {
                    "from": "src/assets/Plaid.VisualElementsManifest.xml",
                    "to": "Plaid.VisualElementsManifest.xml"
                }
            ],
            "publish": [
                "github"
            ]
        },
        "linux": {
            "icon": "assets/appicon/icon.png"
        },
        "mac": {
            "icon": "assets/appicon/icon.icns"
        }
    },
    "scripts": {
        "ng": "ng",
        "serve-dev": "ng serve --port 4300",
        "start-dev": "electron main-dev.js",
        "start": "electron main.js",
        "build": "ng build --configuration production",
        "zip": "cd dist/ && rm -f plaid-windows-portable.zip && zip -r plaid-windows-portable.zip win-unpacked/ && cd ..",
        "package": "electron-builder",
        "publish": "electron-builder --publish always",
        "test": "jest --config jest.config.js",
        "test:watch": "jest --config jest.config.js --watch",
        "test:e2e": "npx playwright test"
    },
    "private": false,
    "dependencies": {
        "@angular/animations": "^21.2.3",
        "@angular/common": "^21.2.3",
        "@angular/compiler": "^21.2.3",
        "@angular/core": "^21.2.3",
        "@angular/forms": "^21.2.3",
        "@angular/platform-browser": "^21.2.3",
        "@angular/platform-browser-dynamic": "^21.2.3",
        "@angular/router": "^21.2.3",
        "@openfonts/comfortaa_latin": "^1.44.4",
        "@openfonts/source-sans-pro_all": "^1.44.2",
        "electron-updater": "^6.8.3",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "^0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.2.2",
        "@angular/build": "^21.2.2",
        "@angular/cli": "^21.2.2",
        "@angular/compiler-cli": "^21.2.3",
        "@angular/language-service": "^21.2.3",
        "@playwright/test": "^1.58.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.19.15",
        "electron": "^41.0.0",
        "electron-builder": "^26.8.1",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-preset-angular": "^17.0.3",
        "postcss": "^8.5.8",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    }
}

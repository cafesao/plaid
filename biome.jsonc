{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Angular templates (*.html) are formatted by Prettier: Biome's HTML support does not understand Angular syntax
    // (biomejs/biome#9513). SVG assets are artwork, not code. Markdown is hand-written prose (docs, specs, plans) and
    // the YAML files are written by pnpm itself.
    "includes": ["**", "!**/*.html", "!**/*.svg", "!**/*.md", "!**/*.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Project rule (AGENTS.md): no non-null assertions.
        "noNonNullAssertion": "error",
        // Off: Angular injects constructor parameters by their runtime class. The rule (and its safe fix) turns those
        // imports into `import type`, which erases the class and breaks dependency injection at runtime.
        "useImportType": "off",
        // Off: reordering selectors changes which rule wins in the cascade, i.e. the app's look.
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        // Off: the stylesheets rely on these overrides; removing them changes the app's look.
        "noImportantStyles": "off",
        // Off: Calendar and Format are helper namespaces used across components; turning them into loose functions
        // is churn with no behavior gain.
        "noStaticOnlyClass": "off"
      },
      "suspicious": {
        // Off while the project compiles with `strict: false`: typing these values belongs to the strict-mode project.
        "noExplicitAny": "off"
      }
    }
  }
}

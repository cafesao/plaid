{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "plaid": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "plaid",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "build/",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets/appicon",
              "src/assets/icons.svg"
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/@openfonts/source-sans-pro_all/index.css",
              "node_modules/@openfonts/comfortaa_latin/index.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "plaid:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "plaid:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "plaid:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "plaid:build",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "polyfills": [
              "zone.js"
            ],
            "providersFile": "src/test-providers.ts"
          }
        }
      }
    }
  }
}

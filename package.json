{
  "name": "plaid",
  "productName": "Plaid",
  "version": "1.0.1",
  "author": {
    "name": "Piotr Marczyński",
    "email": "piotmski@gmail.com"
  },
  "description": "Personal Jira worklog editor",
  "keywords": [
    "jira",
    "worklog",
    "planner",
    "calendar"
  ],
  "license": "MIT",
  "homepage": "https://github.com/piotrmski/plaid",
  "main": "main.js",
  "build": {
    "appId": "com.github.piotrmski.plaid",
    "files": [
      "main.js",
      "bootstrap.js",
      "preload.js",
      "window-state.js",
      "build"
    ],
    "win": {
      "icon": "build/assets/appicon/icon.ico",
      "extraFiles": [
        {
          "from": "src/assets/Plaid.VisualElementsManifest.xml",
          "to": "Plaid.VisualElementsManifest.xml"
        }
      ],
      "publish": [
        "github"
      ]
    },
    "linux": {
      "icon": "assets/appicon/icon.png"
    },
    "mac": {
      "icon": "assets/appicon/icon.icns"
    }
  },
  "scripts": {
    "ng": "ng",
    "serve-dev": "ng serve --port 4300",
    "start-dev": "electron main-dev.js",
    "start": "electron main.js",
    "build": "ng build --configuration production",
    "zip": "cd dist/ && rm -f plaid-windows-portable.zip && zip -r plaid-windows-portable.zip win-unpacked/ && cd ..",
    "package": "electron-builder",
    "publish": "electron-builder --publish always",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:e2e": "playwright test"
  },
  "private": false,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/router": "~22.3.0",
    "@openfonts/comfortaa_latin": "^1.44.5",
    "@openfonts/source-sans-pro_all": "^1.44.2",
    "electron-updater": "^6.8.11",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@angular/language-service": "~22.3.0",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "typescript": "~6.0.3"
  }
}
